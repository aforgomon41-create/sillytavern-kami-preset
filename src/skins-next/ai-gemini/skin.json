{
  "id": "ai-gemini",
  "name": "Gemini",
  "version": "0.1.0",
  "contract": "1.0",
  "description": "Gemini 娘：四角星夜空。紫蓝到粉紫的虹彩渐变、四角星遍布；按下时四角星迸散，背景里星芒明灭。",
  "author": "卡密预设",
  "credits": "角色形象原设：ZipZipPipe（胖次狐，B 站 space.bilibili.com/4168597）；外观参考 lmy414/ai-chan-sheets 设定图补全（CC BY-NC-SA 4.0）。本皮肤的立绘、Q 版、场景、表情与道具图由 AI（Codex 生图）按原设绘制，属二次创作，以 CC BY-NC-SA 4.0 提供：仅限非商业使用、须署名、以相同协议分享。非官方同人作品，与各 AI 公司无关，产品名与商标归其所有。高清图从 jsDelivr 外链加载（会向该 CDN 暴露 IP），载不到时用包内的轻量图。",
  "defaultScheme": "light",
  "schemes": {
    "light": {
      "seeds": {
        "neutral": "#f4f1ff",
        "accent": "#5f45d0",
        "radius": 16,
        "elevation": "glow",
        "font": {
          "heading": "\"ZCOOL QingKe HuangYou\", \"Fredoka\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif"
        },
        "danger": "#c0365a",
        "success": "#2f8f6f",
        "info": "#3f6fd0",
        "warning": "#a8701a"
      }
    },
    "dark": {
      "seeds": {
        "neutral": "#15122b",
        "accent": "#ad9bff",
        "radius": 16,
        "elevation": "glow",
        "font": {
          "heading": "\"ZCOOL QingKe HuangYou\", \"Fredoka\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif"
        },
        "danger": "#ff8fb0",
        "success": "#7fe0c0",
        "info": "#9cc0ff",
        "warning": "#ffc870"
      }
    }
  },
  "modules": [
    "sparks",
    "particles",
    "ambient"
  ],
  "effects": [
    {
      "id": "sparks",
      "name": "星芒迸散",
      "description": "按下与打开时，四角星往外迸散。",
      "group": "动效",
      "default": true
    },
    {
      "id": "particles",
      "name": "星星",
      "description": "打开时冒出一把四角星。",
      "group": "动效",
      "default": true
    },
    {
      "id": "ambient",
      "name": "星芒明灭",
      "description": "面板与消息背景里，星芒一闪一闪。（只在动效「完整」档）",
      "group": "动效",
      "default": true
    },
    {
      "id": "portrait",
      "name": "立绘",
      "description": "面板右下角站着 Gemini 娘（手机上换成 Q 版）。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "scene",
      "name": "场景",
      "description": "对话框与消息背景铺一层淡淡的星空。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "faces",
      "name": "表情头像",
      "description": "思维链与搜索资料的标题前换成 Gemini 娘的表情。",
      "group": "装饰",
      "default": true
    }
  ],
  "params": [
    {
      "id": "corner",
      "name": "圆角",
      "type": "number",
      "default": 16,
      "min": 0,
      "max": 24,
      "step": 1,
      "bind": "seed:radius",
      "group": "形状"
    }
  ],
  "flavor": {
    "think.live": "{name}正在思考",
    "think.done": "{name}的思路",
    "search.done": "参考了 {n} 个网站",
    "options.title": "灵感 ✦"
