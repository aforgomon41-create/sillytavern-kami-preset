{
  "id": "grid",
  "name": "光栅",
  "version": "0.1.0",
  "contract": "1.0",
  "description": "高科技：洁白实验室 / 深空全息；1px 精密细线、点阵网格、毛玻璃、HUD 角标；打开时线条逐笔描出。",
  "author": "卡密预设",
  "credits": "字体 Exo 2（OFL）。",
  "defaultScheme": "light",
  "schemes": {
    "light": {
      "seeds": {
        "neutral": "#f5f7fa",
        "accent": "#0a6cd6",
        "radius": 4,
        "elevation": "outline",
        "font": {
          "heading": "\"Exo 2\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif"
        },
        "danger": "#c8323c",
        "success": "#0f8a5f",
        "info": "#0a6cd6",
        "warning": "#a86b00"
      }
    },
    "dark": {
      "seeds": {
        "neutral": "#05080d",
        "accent": "#4cc9f0",
        "radius": 4,
        "elevation": "glow",
        "font": {
          "heading": "\"Exo 2\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif"
        },
        "danger": "#ff7a85",
        "success": "#4ce0a0",
        "info": "#4cc9f0",
        "warning": "#f5c451"
      }
    }
  },
  "modules": [
    "trace",
    "ripple",
    "ambient"
  ],
  "effects": [
    {
      "id": "ripple",
      "name": "脉冲环",
      "description": "按下与打开时，同心脉冲环扩散。",
      "group": "动效",
      "default": true
    },
    {
      "id": "ambient",
      "name": "数据点",
      "description": "点阵网格里的数据点偶尔亮起。（只在动效「完整」档）",
      "group": "动效",
      "default": true
    },
    {
      "id": "trace",
      "name": "描线",
      "description": "打开、切换时线条逐笔描出，按下时四角闪一下。",
      "group": "动效",
      "default": true
    },
    {
      "id": "dots",
      "name": "点阵",
      "description": "表面铺一层精密点阵网格。",
      "group": "质感",
      "default": true
    },
    {
      "id": "hud",
      "name": "HUD 角标",
      "description": "面板四角的定位角标。",
      "group": "装饰",
      "default": true
    }
  ],
  "flavor": {
    "think.done": "{name} · 推理日志",
    "think.live": "{name} · 推理中",
    "search.done": "检索 {n} 个数据源",
    "options.title": "可选路径"
