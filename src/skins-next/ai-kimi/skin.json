{
  "id": "ai-kimi",
  "name": "Kimi",
  "version": "0.1.0",
  "contract": "1.0",
  "description": "Kimi 娘：月夜音乐厅。深藏青星空、银色月牙与一道棱镜彩虹、五线谱；按下时彩虹棱光掠过，背景飘着音符。",
  "author": "卡密预设",
  "credits": "角色形象原设：ZipZipPipe（胖次狐，B 站 space.bilibili.com/4168597）；外观参考 lmy414/ai-chan-sheets 设定图补全（CC BY-NC-SA 4.0）。本皮肤的立绘、Q 版、场景、表情与道具图由 AI（Codex 生图）按原设绘制，属二次创作，以 CC BY-NC-SA 4.0 提供：仅限非商业使用、须署名、以相同协议分享。非官方同人作品，与各 AI 公司无关，产品名与商标归其所有。高清图从 jsDelivr 外链加载（会向该 CDN 暴露 IP），载不到时用包内的轻量图。",
  "defaultScheme": "dark",
  "schemes": {
    "light": {
      "seeds": {
        "neutral": "#f1f2fa",
        "accent": "#323e86",
        "radius": 12,
        "elevation": "shadow",
        "font": {
          "heading": "\"Quicksand\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif"
        },
        "danger": "#b03a4a",
        "success": "#2f7f6a",
        "info": "#3a62b0",
        "warning": "#9a701a"
      }
    },
    "dark": {
      "seeds": {
        "neutral": "#0f1329",
        "accent": "#aab8f5",
        "radius": 12,
        "elevation": "glow",
        "font": {
          "heading": "\"Quicksand\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif"
        },
        "danger": "#ff9aa8",
        "success": "#8fd8c0",
        "info": "#a8c4ff",
        "warning": "#f0cc7a"
      }
    }
  },
  "modules": [
    "shine",
    "particles",
    "ambient"
  ],
  "effects": [
    {
      "id": "shine",
      "name": "棱镜彩虹",
      "description": "按下与打开时，一道彩虹棱光掠过。",
      "group": "动效",
      "default": true
    },
    {
      "id": "particles",
      "name": "音符",
      "description": "打开时飘出几个音符。",
      "group": "动效",
      "default": true
    },
    {
      "id": "ambient",
      "name": "飘过的音符",
      "description": "面板与消息背景里，音符慢慢飘过。（只在动效「完整」档）",
      "group": "动效",
      "default": true
    },
    {
      "id": "stars",
      "name": "星空",
      "description": "面板背景铺一层细碎星点。",
      "group": "质感",
      "default": true
    },
    {
      "id": "portrait",
      "name": "立绘",
      "description": "面板右下角站着 Kimi 娘（手机上换成 Q 版）。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "scene",
      "name": "场景",
      "description": "对话框与消息背景铺一层淡淡的月夜音乐厅。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "faces",
      "name": "表情头像",
      "description": "思维链与搜索资料的标题前换成 Kimi 娘的表情（搜索没找到资料时换成出错的表情）。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "items",
      "name": "道具",
      "description": "卡片右下角放一件标志道具；选中的选择卡也会出现。",
      "group": "装饰",
      "default": true
    }
  ],
  "params": [
    {
      "id": "corner",
      "name": "圆角",
      "type": "number",
      "default": 12,
      "min": 0,
      "max": 24,
      "step": 1,
      "bind": "seed:radius",
      "group": "形状"
    }
  ],
  "flavor": {
    "think.live": "{name}长思考中",
    "think.done": "{name}长思考完成",
    "search.done": "读完了 {n} 个网页",
    "options.title": "下一小节"
  },
