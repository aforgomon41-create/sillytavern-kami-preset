{
  "id": "quest",
  "name": "远征",
  "version": "0.1.0",
  "contract": "1.0",
  "description": "西幻冒险：羊皮纸、墨线双框、地图等高线、蜡封徽章；打开像卷轴展开。",
  "author": "卡密预设",
  "credits": "字体 IM Fell English（OFL）、Noto Serif SC（OFL）；纹理为 CSS / SVG 绘制。",
  "defaultScheme": "light",
