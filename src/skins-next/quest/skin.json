    "light": {
      "seeds": {
        "neutral": "#efe3c8",
        "accent": "#8a3b1f",
        "radius": 4,
        "elevation": "shadow",
        "font": {
          "heading": "\"IM Fell English\", \"Noto Serif SC\", \"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", STSong, SimSun, serif",
          "body": "\"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", STSong, SimSun, serif"
        },
        "danger": "#a33a2a",
        "success": "#4f6f2f",
        "info": "#3f5f7f",
        "warning": "#8a6420"
      }
    },
    "dark": {
      "seeds": {
        "neutral": "#1f1812",
        "accent": "#d9a441",
        "radius": 4,
        "elevation": "shadow",
        "font": {
          "heading": "\"IM Fell English\", \"Noto Serif SC\", \"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", STSong, SimSun, serif",
          "body": "\"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", STSong, SimSun, serif"
        },
        "danger": "#e0876f",
        "success": "#a9c47a",
        "info": "#93b3cf",
        "warning": "#e6c26e"
      }
    }
  },
  "modules": [
    "unroll",
    "particles",
    "stamp",
    "ambient"
  ],
  "effects": [
    {
      "id": "stamp",
      "name": "蜡封",
      "description": "按下时盖下一枚红蜡封印，打开面板时右上角落印。",
      "group": "动效",
      "default": true
    },
    {
      "id": "ambient",
      "name": "金尘",
      "description": "背景里金色的尘埃缓缓漂浮，像酒馆里的灯下。（只在动效「完整」档）",
      "group": "动效",
      "default": true
    },
    {
      "id": "unroll",
      "name": "卷轴",
      "description": "面板与弹窗像卷轴一样从上往下展开。",
      "group": "动效",
      "default": true
    },
    {
      "id": "particles",
      "name": "烛尘",
      "description": "按下时溅起几点金色微光。",
      "group": "动效",
      "default": true
    },
    {
      "id": "map",
      "name": "地图纹",
      "description": "表面铺一层淡淡的等高线。",
      "group": "质感",
      "default": true
    }
  ],
  "flavor": {
    "think.done": "{name}的行军盘算",
    "think.live": "{name}正在查看地图",
    "search.done": "查阅了 {n} 份古籍",
