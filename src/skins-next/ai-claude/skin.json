{
  "id": "ai-claude",
  "name": "Claude",
  "version": "0.1.0",
  "contract": "1.0",
  "description": "Claude 娘：午后暖光的书房。橘色与奶油白、皮面书的金线与橙色菊花；正文用衬线体，按下时纸页上掠过一道光泽，背景飘橙色花瓣。",
  "author": "卡密预设",
  "credits": "角色形象原设：ZipZipPipe（胖次狐，B 站 space.bilibili.com/4168597）；外观参考 lmy414/ai-chan-sheets 设定图补全（CC BY-NC-SA 4.0）。本皮肤的立绘、Q 版、场景、表情与道具图由 AI（Codex 生图）按原设绘制，属二次创作，以 CC BY-NC-SA 4.0 提供：仅限非商业使用、须署名、以相同协议分享。非官方同人作品，与各 AI 公司无关，产品名与商标归其所有。高清图从 jsDelivr 外链加载（会向该 CDN 暴露 IP），载不到时用包内的轻量图。",
  "defaultScheme": "light",
  "schemes": {
    "light": {
      "seeds": {
        "neutral": "#faf4ea",
        "accent": "#b5541c",
        "radius": 8,
        "elevation": "shadow",
        "font": {
          "heading": "\"Cormorant Garamond\", \"Noto Serif SC\", \"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", STSong, SimSun, serif",
          "body": "\"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", STSong, SimSun, serif"
        },
        "danger": "#b03a2e",
        "success": "#4f7f3a",
        "info": "#3f6f9f",
        "warning": "#a86a12"
      }
    },
    "dark": {
      "seeds": {
        "neutral": "#1d1814",
        "accent": "#f0915a",
        "radius": 8,
        "elevation": "shadow",
        "font": {
          "heading": "\"Cormorant Garamond\", \"Noto Serif SC\", \"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", STSong, SimSun, serif",
          "body": "\"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", STSong, SimSun, serif"
        },
        "danger": "#f08a7a",
        "success": "#9cc98a",
        "info": "#9cbfe0",
        "warning": "#f0b860"
      }
    }
  },
  "modules": [
    "shine",
    "particles",
    "ambient"
  ],
  "effects": [
    {
      "id": "shine",
      "name": "纸页光泽",
      "description": "按下与打开时，一道暖光斜着掠过。",
      "group": "动效",
      "default": true
    },
    {
      "id": "particles",
      "name": "菊瓣",
      "description": "打开时散出几片橙色花瓣。",
      "group": "动效",
      "default": true
    },
    {
      "id": "ambient",
      "name": "飘落的花瓣",
      "description": "面板与消息背景里，橙色菊瓣慢慢飘落。（只在动效「完整」档）",
      "group": "动效",
      "default": true
    },
    {
      "id": "portrait",
      "name": "立绘",
      "description": "面板右下角站着 Claude 娘（手机上换成 Q 版）。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "scene",
      "name": "场景",
      "description": "对话框与消息背景铺一层淡淡的书房。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "faces",
      "name": "表情头像",
      "description": "思维链与搜索资料的标题前换成 Claude 娘的表情（搜索没找到资料时换成出错的表情）。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "items",
      "name": "道具",
      "description": "卡片右下角放一件标志道具；选中的选择卡也会出现。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "stage",
      "name": "角色栏",
      "description": "电脑上面板够宽时，右侧空出一栏站着Claude 娘（手机上是标题栏探头的 Q 版）。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "sign",
      "name": "看板娘",
      "description": "最新一条回复末尾站着 Q 版的Claude 娘，说一句话；生成中和没查到资料时换表情。",
      "group": "装饰",
      "default": true
    }
  ],
  "params": [
    {
      "id": "corner",
      "name": "圆角",
      "type": "number",
      "default": 8,
      "min": 0,
      "max": 24,
      "step": 1,
      "bind": "seed:radius",
      "group": "形状"
    }
  ],
  "flavor": {
    "think.live": "{name}正在思考…",
    "think.done": "{name}想好了",
    "search.done": "查阅了 {n} 份资料",
    "options.title": "接下来呢",
    "sign.live": "容我想想……",
    "sign.done": "这样写，可以吗？",
    "sign.oops": "没查到，我凭记忆来"
  },
