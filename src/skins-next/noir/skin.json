{
  "id": "noir",
  "name": "暗巷",
  "version": "0.1.0",
  "contract": "1.0",
  "description": "悬疑推理：黑色电影——黑白灰与一盏琥珀台灯、打字机字、百叶窗光影、证物标签；光从百叶窗扫过。",
  "author": "卡密预设",
  "credits": "字体 Bebas Neue（OFL）、Courier Prime（OFL）。",
  "defaultScheme": "dark",
  "schemes": {
    "dark": {
      "seeds": {
        "neutral": "#121212",
        "accent": "#d89a3c",
        "radius": 0,
        "elevation": "shadow",
        "font": {
          "heading": "\"Bebas Neue\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"Courier Prime\", FangSong, STFangsong, \"仿宋\", \"Noto Serif CJK SC\", serif",
          "mono": "\"Courier Prime\", ui-monospace, monospace"
        },
        "danger": "#e06a5a",
        "success": "#9ab88a",
        "info": "#9ab0c0",
        "warning": "#d89a3c"
      }
    },
    "light": {
      "seeds": {
        "neutral": "#ecebe6",
        "accent": "#9a2a1f",
        "radius": 0,
        "elevation": "shadow",
        "font": {
          "heading": "\"Bebas Neue\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"Courier Prime\", FangSong, STFangsong, \"仿宋\", \"Noto Serif CJK SC\", serif",
          "mono": "\"Courier Prime\", ui-monospace, monospace"
        },
        "danger": "#9a2a1f",
        "success": "#3f5f3a",
        "info": "#33465a",
        "warning": "#7a5a14"
      }
    }
  },
  "modules": [
    "scan",
    "flash",
    "ambient"
  ],
  "effects": [
    {
      "id": "flash",
      "name": "闪光灯",
      "description": "按下与打开时，闪光灯一闪。",
      "group": "动效",
      "default": true
    },
    {
      "id": "ambient",
      "name": "百叶窗光",
      "description": "光从百叶窗缝里缓缓扫过。（只在动效「完整」档）",
      "group": "动效",
      "default": true
    },
    {
      "id": "scan",
      "name": "百叶窗光",
      "description": "打开、切换页签时一道光扫过。",
      "group": "动效",
      "default": true
    },
    {
      "id": "blinds",
      "name": "百叶窗",
      "description": "表面落着百叶窗的条纹光影。",
      "group": "质感",
      "default": true
    },
    {
      "id": "tag",
      "name": "证物标签",
      "description": "卡片角上挂一枚证物标签。",
      "group": "装饰",
      "default": true
    }
  ],
  "flavor": {
    "think.done": "{name}的推理",
    "think.live": "{name}在推理",
    "search.done": "调查了 {n} 条线索",
