    "light": {
      "seeds": {
        "neutral": "#f2ede2",
        "accent": "#b8322a",
        "radius": 0,
        "elevation": "flat",
        "font": {
          "heading": "\"Ma Shan Zheng\", \"Kaiti SC\", STKaiti, KaiTi, \"楷体\", \"AR PL UKai CN\", serif",
          "body": "\"Kaiti SC\", STKaiti, KaiTi, \"楷体\", \"AR PL UKai CN\", serif"
        },
        "danger": "#a8261f",
        "success": "#3f6a3a",
        "info": "#33536b",
        "warning": "#8a5a14"
      }
    },
    "dark": {
      "seeds": {
        "neutral": "#15130f",
        "accent": "#e0604c",
        "radius": 0,
        "elevation": "flat",
        "font": {
          "heading": "\"Ma Shan Zheng\", \"Kaiti SC\", STKaiti, KaiTi, \"楷体\", \"AR PL UKai CN\", serif",
