  "modules": [
    "ink",
    "slash",
    "ambient"
  ],
  "effects": [
    {
      "id": "slash",
      "name": "刀光",
      "description": "按下与打开时，一道斜刀光闪过。",
      "group": "动效",
      "default": true
    },
    {
      "id": "ambient",
      "name": "竹叶",
      "description": "背景里竹叶斜斜飘落。（只在动效「完整」档）",
      "group": "动效",
      "default": true
    },
    {
      "id": "ink",
      "name": "墨晕",
      "description": "打开时墨晕扩散，按下时溅墨。",
      "group": "动效",
      "default": true
    },
    {
      "id": "brush",
      "name": "笔刷边",
      "description": "面板与卡片的边是一笔刷出来的墨痕。",
      "group": "质感",
      "default": true
    },
    {
      "id": "seal",
      "name": "朱印",
      "description": "面板标题前盖一方朱印。",
      "group": "装饰",
      "default": true
    }
  ],
  "flavor": {
