{
  "id": "sugar",
  "name": "糖霜",
  "version": "0.1.0",
  "contract": "1.0",
  "description": "恋爱轻喜剧：奶油粉白、圆滚滚的贴纸卡片、少女漫画网点；按下 Q 弹，打开时迸出爱心和星星。",
  "author": "卡密预设",
  "credits": "字体 ZCOOL KuaiLe（站酷快乐体，OFL），网点与胶带为 CSS 绘制。",
  "defaultScheme": "light",
  "schemes": {
    "light": {
      "seeds": {
        "neutral": "#fff4f2",
        "accent": "#d6456d",
        "radius": 16,
        "elevation": "shadow",
        "font": {
          "heading": "\"ZCOOL KuaiLe\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif"
        },
        "danger": "#c23b3b",
        "success": "#3f8f6f",
        "info": "#4d7fbf",
        "warning": "#b07a1f"
      }
    },
    "dark": {
      "seeds": {
        "neutral": "#2a2130",
        "accent": "#ff8fb1",
        "radius": 16,
        "elevation": "shadow",
        "font": {
          "heading": "\"ZCOOL KuaiLe\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
          "body": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif"
        },
        "danger": "#ff8a8a",
        "success": "#7fd6b0",
        "info": "#9cc3ff",
        "warning": "#ffcf7a"
      }
    }
  },
  "modules": [
    "particles",
    "words",
    "ambient"
  ],
  "effects": [
    {
      "id": "words",
      "name": "拟声字",
      "description": "按下和打开时弹出「ドキッ」「キュン」这类漫画拟声字。",
      "group": "动效",
      "default": true
    },
    {
      "id": "ambient",
      "name": "心动泡泡",
      "description": "面板与消息背景里，小爱心泡泡慢慢往上浮。（只在动效「完整」档）",
      "group": "动效",
      "default": true
    },
    {
      "id": "particles",
      "name": "心动",
      "description": "按下和打开时迸出爱心与星星。",
      "group": "动效",
      "default": true
    },
    {
      "id": "dots",
      "name": "网点",
      "description": "背景铺一层少女漫画网点。",
      "group": "质感",
      "default": true
    },
    {
      "id": "tape",
      "name": "胶带",
      "description": "卡片角上贴一截纸胶带。",
      "group": "装饰",
      "default": true
    }
  ],
  "params": [
    {
      "id": "corner",
      "name": "圆角",
      "type": "number",
      "default": 16,
      "min": 0,
      "max": 24,
      "step": 1,
      "bind": "seed:radius",
      "group": "形状"
    }
  ],
  "flavor": {
    "think.done": "{name}的小心思",
    "think.live": "{name}心跳加速中",
    "search.done": "翻了 {n} 本恋爱指南",
    "options.title": "下一格分镜"
  },
