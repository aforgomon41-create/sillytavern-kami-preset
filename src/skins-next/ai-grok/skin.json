  "modules": [
    "slash",
    "particles",
    "ambient"
  ],
  "effects": [
    {
      "id": "slash",
      "name": "X 字斩",
      "description": "按下与打开时，一记金色斜斩。",
      "group": "动效",
      "default": true
    },
    {
      "id": "particles",
      "name": "金尘",
      "description": "打开时迸出一把金色碎光。",
      "group": "动效",
      "default": true
    },
    {
      "id": "ambient",
      "name": "金色微尘",
      "description": "面板与消息背景里，金色微尘慢慢飘。（只在动效「完整」档）",
      "group": "动效",
      "default": true
    },
    {
      "id": "portrait",
      "name": "立绘",
      "description": "面板右下角站着 Grok 娘（手机上换成 Q 版）。",
      "group": "装饰",
      "default": true
    },
    {
      "id": "scene",
      "name": "场景",
      "description": "对话框与消息背景铺一层淡淡的古堡露台。",
      "group": "装饰",
      "default": true
    }
  ],
  "params": [
    {
      "id": "corner",
      "name": "圆角",
      "type": "number",
      "default": 2,
      "min": 0,
      "max": 24,
      "step": 1,
      "bind": "seed:radius",
      "group": "形状"
    }
  ],
