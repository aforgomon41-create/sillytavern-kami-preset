    "light": {
      "seeds": {
        "neutral": "#f6efe4",
        "accent": "#7e1d2b",
        "radius": 2,
        "elevation": "shadow",
        "font": {
          "heading": "\"Cinzel\", \"Noto Serif SC\", \"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", STSong, SimSun, serif",
          "body": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif"
        },
